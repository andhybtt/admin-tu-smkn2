# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION FOR DOKPLOY
# Salin konfigurasi di bawah ini ke menu "Environment" di Dokploy Application
# ==============================================================================

# Nama Aplikasi
APP_NAME="SIM Administrasi Guru"
APP_ENV=production

# Base URL (Kosongkan jika domain langsung mengarah ke root aplikasi di Dokploy)
BASE_URL=""

# Database Configuration (Sesuaikan dengan Database Dokploy / MySQL Server)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_administrasi_guru
DB_USER=root
DB_PASSWORD=secret_password

# Timezone
TZ=Asia/Jakarta
